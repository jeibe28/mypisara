# Neon pooled PostgreSQL connection. Without it, MyPisara runs in browser-only demo mode.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# http://localhost:3000 locally, and the exact public origin in production.
BETTER_AUTH_URL=http://localhost:3000

# Private Vercel Blob store for board images and files.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Set true to stop new sign-ups (private use). Leave false for a public release.
DISABLE_SIGN_UP=false

# Storage each account may use for uploaded files, in MB. Defaults to 1024 (1 GB).
STORAGE_QUOTA_MB=1024

# Transactional email (password reset, email confirmation) through Resend.
# Without both values these features stay off in production.
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=MyPisara <hello@your-domain.com>
